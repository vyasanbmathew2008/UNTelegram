# --- Required (https://my.telegram.org -> API development tools) ---
API_ID = 23877053
API_HASH = 989c360358b981dae46a910693ab2f4c
# --- Server ---
HOST=127.0.0.1
PORT=8000

# Secret used to sign the browser cookie. Leave empty to auto-generate one in sessions/.secret_key
SECRET_KEY=
# Set to 1 when served over HTTPS (marks the cookie Secure)
COOKIE_SECURE=0
# Browser login lifetime, in hours
WEB_SESSION_HOURS=168
# Disconnect idle Telegram connections after this many minutes (they reconnect on next request)
IDLE_DISCONNECT_MINUTES=30

# --- Storage ---
SESSION_DIR=sessions
# Downloads are saved on the machine running this server, inside this folder.
# Termux example (after `termux-setup-storage`): DOWNLOAD_ROOT=~/storage/downloads/telegram
DOWNLOAD_ROOT=downloads

# --- Limits ---
MAX_BATCH=500
MAX_CONCURRENT_DOWNLOADS=2
